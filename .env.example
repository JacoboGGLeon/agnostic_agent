# Core runtime
AGNOSTIC_PROFILE=dev
AGNOSTIC_PIPELINE_V2=true
AGNOSTIC_STRICT_PLUGINS=false

# OpenAI-compatible
OPENAI_API_KEY=your_api_key_here
VLLM_API_BASE=http://localhost:8000/v1
LLM_SERVED_NAME=agnostic-llm

# Optional provider overrides
AGNOSTIC_LLM_PROVIDER=vllm
AGNOSTIC_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
