{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "capabilities_menuOutput",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "ok",
    "summary",
    "planned_tool_calls"
  ],
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "summary": {
      "type": "string"
    },
    "planned_tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "trace": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "error": {
      "type": "string"
    }
  }
}